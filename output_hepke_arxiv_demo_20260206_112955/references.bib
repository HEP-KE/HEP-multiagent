@article{arxivastroph0510346,
  title = {The Dark Energy Survey},
  author = {The Dark Energy Survey Collaboration},
  year = {2005},
  eprint = {astro-ph/0510346},
  note = {["We describe the Dark Energy Survey (DES), a proposed optical-near infrared survey of 5000 sq. deg of the South Galactic Cap to ~24th magnitude in SDSS griz", "The survey data will allow us to measure the dark energy and dark matter densities and the dark energy equation of state through four independent methods: galaxy clusters, weak gravitational lensing tomography, galaxy angular clustering, and supernova distances"]}
}

@article{arxiv180909971,
  title = {Possible Couplings of Dark Matter},
  author = {Kevin J. Ludwick},
  year = {2018},
  eprint = {1809.09971},
  note = {["Dark matter interacts gravitationally, but it presumably interacts weakly through other channels, especially with respect to regular luminous matter", "We also show an example of a theory beyond the Standard Model in which dark matter is uniquely connected to the inflaton, and we use observational astrophysical constraints to specify an upper bound on the dark matter mass"]}
}

@article{arxiv13051605,
  title = {Dark Matter in the Coming Decade: Complementary Paths to Discovery and Beyond},
  author = {Daniel Bauer and James Buckley and Matthew Cahill-Rowley and Randel Cotta and Alex Drlica-Wagner and Jonathan L. Feng and Stefan Funk and JoAnne Hewett and Dan Hooper and Ahmed Ismail and Manoj Kaplinghat and Alexander Kusenko and Konstantin Matchev and Daniel McKinsey and Tom Rizzo and William Shepherd and Tim M. P. Tait and Alexander M. Wijangco and Matthew Wood},
  year = {2013},
  eprint = {1305.1605},
  note = {["In this report we summarize the many dark matter searches currently being pursued through four complementary approaches: direct detection, indirect detection, collider experiments, and astrophysical probes", "Our primary conclusion is that the diversity of possible dark matter candidates requires a balanced program drawing from all four approaches"]}
}

@article{arxiv12117222,
  title = {Direct dark matter detection: the next decade},
  author = {Laura Baudis},
  year = {2012},
  eprint = {1211.7222},
  note = {["Direct dark matter searches are promising techniques to identify the nature of dark matter particles", "I will present the main techniques and R&D projects that will allow to build so-called ultimate WIMP detectors, capable of probing spin-independent interactions down to the unimaginably low cross section of 1e-48 cm2"]}
}

@article{arxiv11101056,
  title = {Directional detection of Dark Matter},
  author = {F. Mayet and J. Billard and D. Santos},
  year = {2011},
  eprint = {1110.1056},
  note = {["Directional detection is a promising Dark Matter search strategy", "Taking advantage on the rotation of the Solar system around the galactic center through the Dark Matter halo, it allows to show a direction dependence of WIMP events"]}
}

